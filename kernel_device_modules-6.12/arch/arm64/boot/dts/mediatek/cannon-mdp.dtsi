// Native MT6853 MDP bindings, with Cannon stock component references.
// LK clock measurement: MDP 593999787 Hz (~594MHz), IMG1/2 624MHz.
// Only normal GCE threads 19..22 are available; thread 23 is diagnostic.
&{/mdp_rdma0@1f003000} {
 compatible = "mediatek,mdp_rdma0";
};
/ {
 cannon_mdp_fixed_opp: cannon-mdp-fixed-opp {
  compatible = "operating-points-v2";
  opp-594000000 { opp-hz = /bits/ 64 <594000000>; opp-microvolt = <725000>; };
 };
