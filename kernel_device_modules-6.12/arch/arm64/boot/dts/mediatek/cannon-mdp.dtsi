// Data imports need the real MDP IOMMU client; command packets use GCE DMA.
/* Native MT6853 MDPSYS consumer binding (single LARB per DMA client). */
&{/mdpsys_config@1f000000} {
 dma-ranges = <0x2 0x0 0x2 0x0 0x1 0x0>;
 iommus = <0x83 0x20040 0x83 0x20041 0x83 0x20042 0x83 0x20043>;
 dma-mask-bit = <34>;
};
