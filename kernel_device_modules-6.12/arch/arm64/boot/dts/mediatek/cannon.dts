&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vsram_others} {
	regulator-compatible = "ldo-vsram-others";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vefuse} {
	regulator-compatible = "ldo-vefuse";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vxo22} {
	regulator-compatible = "ldo-vxo22";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vrfck} {
	regulator-compatible = "ldo-vrfck";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vbif28} {
