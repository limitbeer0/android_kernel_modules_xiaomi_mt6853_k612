};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vio28} {
	regulator-compatible = "ldo-vio28";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vemc} {
