};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vrf12} {
	regulator-compatible = "ldo-vrf12";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vusb} {
	regulator-compatible = "ldo-vusb";
