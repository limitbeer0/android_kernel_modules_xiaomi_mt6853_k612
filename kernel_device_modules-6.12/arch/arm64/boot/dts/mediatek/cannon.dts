&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vsim2} {
	regulator-compatible = "ldo-vsim2";
};

&{/ufshci@11270000} {
	compatible = "mediatek,mt6853-ufshci", "mediatek,ufshci";
	mediatek,infracfg = <0x2b>;
	// Bring-up keeps the legacy reference clock and link powered.
	/delete-property/ mediatek,rpm-enable;
};

&{/pwrap@10026000/mt6359-pmic} {
	cannon-pmic-keys {
		compatible = "mediatek,mt6359p-keys";
		power {
			linux,keycodes = <116>; // KEY_POWER; release is PMIC IRQ 50.
		};
	};
};
