};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vcamio} {
	regulator-compatible = "ldo-vcamio";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vcn18} {
	regulator-compatible = "ldo-vcn18";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vfe28} {
