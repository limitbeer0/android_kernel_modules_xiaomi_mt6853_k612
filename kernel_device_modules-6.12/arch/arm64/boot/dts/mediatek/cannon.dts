};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vsim1} {
	regulator-compatible = "ldo-vsim1";
};

&{/pwrap@10026000/mt6359-pmic/mt6359regulator/ldo_vibr} {
