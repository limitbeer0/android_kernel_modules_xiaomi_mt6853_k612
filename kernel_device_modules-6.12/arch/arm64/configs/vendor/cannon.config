# Cannon first-stage bring-up, merged over gki_defconfig (NOT the xaga fragment).
CONFIG_CANNON_BRINGUP=y
CONFIG_LOCALVERSION="-cannon-bringup"
CONFIG_LOCALVERSION_AUTO=n
CONFIG_ARCH_MEDIATEK=y
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_QCOM=n
CONFIG_ARM64_4K_PAGES=y
CONFIG_COMPAT=y
# Use LK/DT arguments, without GKI's ttynull and protected-KVM defaults.
CONFIG_CMDLINE=""
CONFIG_CMDLINE_EXTEND=n
CONFIG_CMDLINE_FORCE=n
CONFIG_KVM=n
# Keep firmware's clock and idle setup until the matching PM/DVFS code is ported.
CONFIG_CPU_IDLE=n
CONFIG_CPU_FREQ=n
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=n
CONFIG_MODULE_SIG_FORCE=n
CONFIG_MODVERSIONS=n
CONFIG_LTO_NONE=y
CONFIG_LTO_CLANG_THIN=n
CONFIG_LTO_CLANG_FULL=n
CONFIG_CFI_CLANG=n
CONFIG_SHADOW_CALL_STACK=n
CONFIG_DEBUG_INFO_NONE=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=n
CONFIG_DEBUG_INFO_BTF=n
CONFIG_DEBUG_INFO_BTF_MODULES=n
CONFIG_WERROR=n
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_IKHEADERS=n
CONFIG_TIME_KUNIT_TEST=n
CONFIG_KUNIT=n
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_RAM=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=20
CONFIG_PANIC_TIMEOUT=10
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_WATCHDOG=y
CONFIG_MEDIATEK_WATCHDOG=y
CONFIG_DEVICE_MODULES_COMMON_CLK_MEDIATEK=m
CONFIG_COMMON_CLK_MT6853=m
CONFIG_COMMON_CLK_MT6853_APU0=m
CONFIG_COMMON_CLK_MT6853_APU1=m
CONFIG_COMMON_CLK_MT6853_APU_VCORE=m
CONFIG_COMMON_CLK_MT6853_APU_CONN=m
CONFIG_COMMON_CLK_MT6853_AUDIOSYS=m
CONFIG_COMMON_CLK_MT6853_CAMSYS_MAIN=m
CONFIG_COMMON_CLK_MT6853_CAMSYS_RAWA=m
CONFIG_COMMON_CLK_MT6853_CAMSYS_RAWB=m
CONFIG_COMMON_CLK_MT6853_IMGSYS1=m
CONFIG_COMMON_CLK_MT6853_IMGSYS2=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_C=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_E=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_N=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_S=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_W=m
CONFIG_COMMON_CLK_MT6853_IMP_IIC_WRAP_WS=m
CONFIG_COMMON_CLK_MT6853_IPESYS=m
CONFIG_COMMON_CLK_MT6853_MDPSYS_CONFIG=m
CONFIG_COMMON_CLK_MT6853_MFGCFG=m
CONFIG_COMMON_CLK_MT6853_MMSYS_CONFIG=m
CONFIG_COMMON_CLK_MT6853_SCP_ADSP=m
CONFIG_COMMON_CLK_MT6853_VDEC_GCON=m
CONFIG_COMMON_CLK_MT6853_VENC_GCON=m
CONFIG_PINCTRL_MT6853=m
CONFIG_DEVICE_MODULES_PINCTRL_MTK_PARIS=m
CONFIG_DEVICE_MODULES_PINCTRL_MTK_V2=m
CONFIG_DEVICE_MODULES_EINT_MTK=m
CONFIG_DEVICE_MODULES_MTK_PMIC_WRAP=m
CONFIG_MTK_PMIC_WRAP=n
CONFIG_DEVICE_MODULES_MFD_MT6397=m
CONFIG_MFD_MT6397=n
CONFIG_REGULATOR_MT6359P=m
CONFIG_REGULATOR_MT6359=n
# Keep physical-address-specific xaga diagnostics disabled on cannon.
CONFIG_XAGA_MARKER_WRITER=n
CONFIG_XAGA_KMSG2USB=n
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_CANNON_ION_COMPAT=m

# 6.12 display transport and multimedia memory providers, as modules.
CONFIG_MTK_CMDQ_MBOX_EXT=m
CONFIG_MTK_CMDQ_DEBUG=n
CONFIG_DEVICE_MODULES_MTK_IOMMU=m
CONFIG_DEVICE_MODULES_MTK_SMI=m
CONFIG_DEVICE_MODULES_MTK_SCPSYS=m
CONFIG_DEVICE_MODULES_DRM_MEDIATEK=m
CONFIG_DRM_MEDIATEK_V2=y
CONFIG_MTK_MML=n
CONFIG_MTK_MML_LEGACY=n
CONFIG_MTK_IOMMU=n
CONFIG_MTK_SMI=n
CONFIG_MTK_IOMMU_MISC_DBG=n
CONFIG_MTK_IOMMU_MISC_SECURE=n

# cannon j22 display panels and LM36273 backlight, ported from 4.14.
CONFIG_DRM_PANEL_J22_42_02_0A_VDO=m
CONFIG_DRM_PANEL_J22_43_03_0B_VDO=m
CONFIG_DRM_PANEL_J22_43_03_0C_VDO=m
CONFIG_DRM_PANEL_LEDS_LM36273=m
CONFIG_TOUCHSCREEN_XIAOMI_DOUBLE_CLICK=m

CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_MEDIATEK=n
CONFIG_DEVICE_MODULES_SCSI_UFS_MEDIATEK=n
CONFIG_CANNON_UFS_MT6853=m

CONFIG_DEVICE_MODULES_KEYBOARD_MTK_PMIC=m
CONFIG_KEYBOARD_MTK_PMIC=n
CONFIG_CANNON_POWERKEY_PANIC=y


# Microtrust TEEI 400: backported from the running 4.14 firmware ABI.
CONFIG_TEE=y
CONFIG_MTK_TEE_GP_SUPPORT=y
CONFIG_MICROTRUST_TEE_SUPPORT=m
CONFIG_MICROTRUST_TEE_VERSION="400"
CONFIG_MICROTRUST_TZ_DRIVER=y
CONFIG_MICROTRUST_VFS_DRIVER=y
CONFIG_MICROTRUST_FP_DRIVER=y
CONFIG_MICROTRUST_KEYMASTER_DRIVER=y
CONFIG_MICROTRUST_DEBUG=y
CONFIG_MICROTRUST_UNITTEST_SUPPORT=n
CONFIG_MICROTRUST_TZ_LOG=y
CONFIG_MICROTRUST_TEST_DRIVERS=n

# RPMB: tee-supplicant needs /dev/rpmb0 for secure-world TA storage.
CONFIG_MTK_RPMB=m
CONFIG_RPMB_INTF_DEV=y

# USB debug bring-up: peripheral role avoids the unported Type-C/charger stack.
# The controller and PHY are staged explicitly from the common kernel build.
CONFIG_USB_MTU3=m
CONFIG_USB_MTU3_GADGET=y
CONFIG_USB_MTU3_HOST=n
CONFIG_USB_MTU3_DUAL_ROLE=n
CONFIG_PHY_MTK_TPHY=m
CONFIG_DEVICE_MODULES_USB_MTU3=n
CONFIG_DEVICE_MODULES_PHY_MTK_TPHY=n
